      "item": [
        {
          "name": "Oráculo sí/no",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/oracle/yesno",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "oracle",
                "yesno"
              ]
            },
            "description": "Only the question is sent. Ask yes/no questions: an open question also gets a yes or no.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"¿Me saldrá bien el examen de mañana?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
