# Copy to server/.env on void-server (git-ignored). No "$" in values, or
# escape as "$$" (Docker Compose interpolates env_file values).

# Comma-separated id:key pairs, one per client. Generate keys with: openssl rand -hex 32
# Remove a pair and restart to revoke that client.
ARGOS_API_KEYS=cli:REPLACE_WITH_KEY,kaizen:REPLACE_WITH_KEY

# Hugging Face commit of convaiinnovations/laya (validated in the Pi spike).
ARGOS_MODEL_REVISION=55cf4c4ebb4ebe31b2550e8bdf3bd21b99753851

# Torch threads (Pi 4 has 4 cores) and requests allowed to wait for the model.
ARGOS_THREADS=3
ARGOS_MAX_QUEUE=4

# Public host of the API (Traefik router rule). Point its DNS record at this server.
ARGOS_API_HOST=argos-api.example.com

# Browser origins allowed to call the API (CORS), comma-separated: the web wizard's origin,
# e.g. https://argos.example.com. Empty (default) disables CORS.
ARGOS_CORS_ORIGINS=

# Traefik names used in docker-compose.yml labels (defaults shown).
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=le
