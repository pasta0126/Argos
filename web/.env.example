# Copy to web/.env (git-ignored).

# Public host of the wizard (Traefik router rule). Point its DNS record at this server.
ARGOS_WEB_HOST=argos.example.com

# URL of your Argos API, as the browser reaches it. Baked into the build and allowed in the
# CSP. The API must list this wizard's origin in ARGOS_CORS_ORIGINS (server/.env).
ARGOS_API_URL=https://argos-api.example.com

# Only if this host used to serve the API: its old API paths answer 308 to this URL.
# ARGOS_LEGACY_API_URL=https://argos-api.example.com

# Traefik names used in docker-compose.yml labels (defaults shown).
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=le
